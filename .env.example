# LinkedIn Connection Automation — Environment Configuration

# Company name to filter connection targets (case-insensitive)
TARGET_COMPANY=certisign

# Full LinkedIn search URL (overrides default keyword search)
LINKEDIN_SEARCH_URL=https://www.linkedin.com/search/results/people/?keywords=certisign&network=["S"]

# LinkedIn network filter: F=1º grau, S=2º grau, O=fora da rede. Combinações: F,S
LINKEDIN_NETWORK_FILTER=S

# Delay between scroll actions (ms)
DELAY_BETWEEN_ACTIONS=2500

# Delay after each scroll event (ms)
DELAY_AFTER_SCROLL=1500

# Delay between connection sends (ms). If set, disables random jitter.
DELAY_BETWEEN_CONNECTIONS=

# Maximum scrolls per page load
MAX_SCROLLS=15

# Retry attempts on element action failure
MAX_RETRIES=3
